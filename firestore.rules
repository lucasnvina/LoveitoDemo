rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(ownerId) { return isSignedIn() && request.auth.uid == ownerId; }

    match /pets/{petId} {

      // Crear mascota: el ownerId enviado debe coincidir con el usuario logueado
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid;

      // Leer/actualizar/borrar mascota: sólo su dueño
      allow read: if isOwner(resource.data.ownerId);
      allow update, delete: if isOwner(resource.data.ownerId);

      // Subcolección de crisis de esa mascota
      match /crises/{crisisId} {

        // Helper: verificar que la mascota existe y es del usuario
        function petIsMine() {
          return isSignedIn()
                 && exists(/databases/$(database)/documents/pets/$(petId))
                 && get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid;
        }

        // Crear crisis: dueñ@ logueado y consistencia de IDs
        allow create: if petIsMine()
                      && request.resource.data.ownerId == request.auth.uid
                      && request.resource.data.petId == petId;

        // Leer/editar/borrar crisis: sólo si la mascota es del usuario
        allow read, update, delete: if petIsMine();
      }

      // Subcolección de recomendaciones
      match /care_recommendations/{recId} {
        function petIsMine() {
          return isSignedIn()
                 && exists(/databases/$(database)/documents/pets/$(petId))
                 && get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid;
        }

        // Lectura: dueño de la mascota
        allow read: if petIsMine();

        // Escritura total: bloqueada para clientes; sólo backend (Admin SDK) puede escribir contenido
        allow create, delete: if false; // sólo Cloud Functions (Admin)

        // Actualización: permitir únicamente cambios de status o snoozeUntil por el dueño
        allow update: if petIsMine()
                      && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status", "snoozeUntil", "updatedAt"])
                      && request.resource.data.status in ["active", "done", "dismissed", "snoozed"]
                      && (request.resource.data.snoozeUntil == null || request.resource.data.snoozeUntil is timestamp);
      }
    }


  match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

}
}
