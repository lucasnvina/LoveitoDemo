<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvCareTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/care_screen_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/nunito_semibold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <!-- Placeholder 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_pet_item"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:elevation="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/care_topic_hygiene"
                android:textStyle="bold"
                android:textSize="16sp"
                android:fontFamily="@font/nunito_semibold"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/care_placeholder_coming_soon"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:fontFamily="@font/nunito_light"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Placeholder 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_pet_item"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:elevation="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/care_topic_exercise"
                android:textStyle="bold"
                android:textSize="16sp"
                android:fontFamily="@font/nunito_semibold"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/care_placeholder_coming_soon"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:fontFamily="@font/nunito_light"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Placeholder 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_pet_item"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:elevation="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/care_topic_food"
                android:textStyle="bold"
                android:textSize="16sp"
                android:fontFamily="@font/nunito_semibold"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/care_placeholder_coming_soon"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:fontFamily="@font/nunito_light"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Placeholder 4 -->
        <LinearLayout
