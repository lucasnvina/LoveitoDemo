<?xml version="1.0" encoding="utf-8"?>
<!-- Card de recomendación de cuidado con el mismo estilo visual que profesionales/medicación -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_pet_item"
    android:elevation="4dp"
    android:padding="12dp"
    android:layout_marginBottom="12dp"
    android:longClickable="true">

    <!-- Título -->
    <TextView
        android:id="@+id/tvCareItemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/nunito_semibold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="4dp" />

    <!-- Cuerpo -->
    <TextView
        android:id="@+id/tvCareItemBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:fontFamily="@font/nunito_light"
        android:textColor="@color/text_secondary" />

    <!-- Evidencia (opcional) -->
    <TextView
        android:id="@+id/tvCareItemEvidence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="13sp"
        android:fontFamily="@font/nunito_semibold"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <!-- Fila de acciones: Hecho / Posponer / Descartar -->
    <LinearLayout
        android:id="@+id/llCareActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCareDone"
            style="@style/NunitoBoldButtonRounded"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="32dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/done_label"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <View
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCareSnooze"
            style="@style/NunitoBoldButtonRounded"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="32dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/snooze_label"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <View
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCareDismiss"
            style="@style/NunitoBoldButtonRounded.Destructive"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="32dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/dismiss_label"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
