<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Nombre arriba de todo -->
            <TextView
                android:id="@+id/tvSName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textAlignment="viewStart"
                android:textStyle="bold"
                android:fontFamily="@font/nunito_semibold"
                android:textSize="26sp"
                android:layout_marginBottom="0dp"
                android:textColor="@color/text_primary"
                android:paddingStart="16dp"
                android:paddingEnd="0dp"
                android:layout_marginTop="8dp"
                android:paddingTop="0dp" />

            <!-- VIEW MODE -->
            <LinearLayout
                android:id="@+id/groupView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Tarjeta de datos con foto y datos -->
                <LinearLayout
                    android:id="@+id/cardSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_pet_item"
                    android:elevation="4dp"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginTop="0dp"
                    android:gravity="center_vertical">
                    <!-- Foto a la izquierda -->
                    <FrameLayout
                        android:layout_width="128dp"
                        android:layout_height="128dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/pet_photo_border"
                        android:layout_marginEnd="16dp">
                        <ImageView
                            android:id="@+id/ivSummaryPhoto"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            android:contentDescription="@string/pet_photo_desc"
                            android:padding="0dp"
                            android:clipToOutline="true"
                            android:outlineProvider="background"
                            android:background="@drawable/circle_transparent" />
                    </FrameLayout>
                    <!-- Datos a la derecha -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="start"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">
                        <!-- Campos con etiqueta en Nunito Bold y dato en Nunito Light -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="start|center_vertical" android:baselineAligned="false">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pet_label_breed" android:textStyle="bold" android:fontFamily="@font/nunito_semibold" android:textColor="@color/text_primary" android:paddingStart="0dp" android:paddingEnd="4dp" />
                            <TextView android:id="@+id/tvSBreed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:fontFamily="@font/nunito_light" android:paddingStart="0dp" android:paddingEnd="4dp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="start|center_vertical" android:baselineAligned="false">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pet_label_weight" android:textStyle="bold" android:fontFamily="@font/nunito_semibold" android:textColor="@color/text_primary" android:paddingEnd="4dp" />
                            <TextView android:id="@+id/tvSWeight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:fontFamily="@font/nunito_light" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="start|center_vertical" android:baselineAligned="false">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pet_label_sex" android:textStyle="bold" android:fontFamily="@font/nunito_semibold" android:textColor="@color/text_primary" android:paddingEnd="4dp" />
                            <TextView android:id="@+id/tvSSex" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:fontFamily="@font/nunito_light" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="start|center_vertical" android:baselineAligned="false">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pet_label_birth" android:textStyle="bold" android:fontFamily="@font/nunito_semibold" android:textColor="@color/text_primary" android:paddingEnd="4dp" />
                            <TextView android:id="@+id/tvSBirth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:fontFamily="@font/nunito_light" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="start|center_vertical" android:baselineAligned="false">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pet_label_age" android:textStyle="bold" android:fontFamily="@font/nunito_semibold" android:textColor="@color/text_primary" android:paddingEnd="4dp" />
                            <TextView android:id="@+id/tvSAge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:fontFamily="@font/nunito_light" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="start|center_vertical" android:baselineAligned="false">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pet_label_neutered" android:textStyle="bold" android:fontFamily="@font/nunito_semibold" android:textColor="@color/text_primary" android:paddingEnd="4dp" />
                            <TextView android:id="@+id/tvSNeutered" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:fontFamily="@font/nunito_light" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="start|center_vertical" android:baselineAligned="false">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pet_label_height" android:textStyle="bold" android:fontFamily="@font/nunito_semibold" android:textColor="@color/text_primary" android:paddingEnd="4dp" />
                            <TextView android:id="@+id/tvSHeight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:fontFamily="@font/nunito_light" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="start|center_vertical" android:baselineAligned="false">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pet_label_length" android:textStyle="bold" android:fontFamily="@font/nunito_semibold" android:textColor="@color/text_primary" android:paddingEnd="4dp" />
                            <TextView android:id="@+id/tvSLength" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:fontFamily="@font/nunito_light" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Sección horizontal: Última Crisis y Tiempo medio -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <!-- Sección: Última Crisis (izquierda) -->
                    <LinearLayout
                        android:id="@+id/sectionLastCrisis"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_pet_item"
                        android:elevation="4dp"
                        android:padding="12dp"
                        android:layout_marginEnd="2dp"
                        android:gravity="center_vertical">
                        <!-- Icono corazón -->
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_heart"
                            android:contentDescription="@string/heart_desc"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="12dp" />
                        <!-- Título y fecha -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/last_crisis_label"
                                android:textStyle="bold"
                                android:fontFamily="@font/nunito_semibold"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:gravity="start"
                                android:paddingBottom="2dp" />
                            <TextView
                                android:id="@+id/tvLastCrisisDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/no_crisis_registered"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                android:fontFamily="@font/nunito_light"
                                android:gravity="start" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Sección: Tiempo medio (derecha) -->
                    <LinearLayout
                        android:id="@+id/sectionAvgTime"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_pet_item"
                        android:elevation="4dp"
                        android:padding="12dp"
                        android:layout_marginStart="2dp"
                        android:gravity="center_vertical">
                        <!-- Icono reloj -->
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_timer"
                            android:contentDescription="@string/avg_time_desc"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="12dp" />
                        <!-- Título y valor -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/avg_time_label"
                                android:textStyle="bold"
                                android:fontFamily="@font/nunito_semibold"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:gravity="start"
                                android:paddingBottom="2dp" />
                            <TextView
                                android:id="@+id/tvAvgCrisisTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dash"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                android:fontFamily="@font/nunito_light"
                                android:gravity="start" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Sección horizontal: Compartir y Medicación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <!-- Sección: Compartir (izquierda) -->
                    <LinearLayout
                        android:id="@+id/sectionShare"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_pet_item"
                        android:elevation="4dp"
                        android:padding="12dp"
                        android:layout_marginEnd="2dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_share"
                            android:contentDescription="@string/share_desc"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_vertical"
                            android:baselineAligned="false">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/share_label"
                                android:textStyle="bold"
                                android:fontFamily="@font/nunito_semibold"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:gravity="start"
                                android:paddingBottom="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Sección: Medicación (derecha) -->
                    <LinearLayout
                        android:id="@+id/sectionMedication"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_pet_item"
                        android:elevation="4dp"
                        android:padding="12dp"
                        android:layout_marginStart="4dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_info_details"
                            android:contentDescription="@string/medication_desc"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_vertical"
                            android:baselineAligned="false">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/medication_label"
                                android:textStyle="bold"
                                android:fontFamily="@font/nunito_semibold"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:gravity="start"
                                android:paddingBottom="2dp" />
                            <!-- Nueva TextView para resumen de medicación -->
                            <TextView
                                android:id="@+id/tvMedicationSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/medication_no_info"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                android:fontFamily="@font/nunito_light"
                                android:gravity="start" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Card colapsable: Recomendaciones -->

                <LinearLayout
                    android:id="@+id/cardRecommendations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_pet_item"
                    android:elevation="4dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Header colapsable -->
                    <LinearLayout
                        android:id="@+id/headerRecommendations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="@string/recommendations_desc"
                            android:src="@android:drawable/ic_dialog_info"
                            app:tint="@color/accent_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_semibold"
                            android:gravity="start"
                            android:text="@string/recommendations_label"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:id="@+id/ivCollapseArrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:contentDescription="@string/collapse_desc"
                            android:src="@android:drawable/arrow_down_float" />
                    </LinearLayout>

                    <!-- Contenido colapsable -->
                    <LinearLayout
                        android:id="@+id/contentRecommendations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:fontFamily="@font/nunito_light"
                            android:text="@string/recommendation_item_1"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:fontFamily="@font/nunito_light"
                            android:text="@string/recommendation_item_2"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:fontFamily="@font/nunito_light"
                            android:text="@string/recommendation_item_3"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_btn_edit"
                    style="@style/NunitoBoldButtonRounded"
                    android:layout_marginTop="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_gravity="center"
                    android:backgroundTint="@color/accent_primary"
                    android:textColor="@color/accent_on"
                    app:cornerRadius="32dp" />

                <!-- Removed btnDeletePet from view mode -->
                <!-- Spacer to ensure last button can scroll above logo -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="112dp" />
            </LinearLayout>

            <!-- EDIT MODE -->
            <LinearLayout
                android:id="@+id/groupEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="32dp"
                android:theme="@style/ThemeOverlay.Loveito.CursorMaroon">

                <!-- Nueva foto centrada en modo edición -->
                <FrameLayout
                    android:id="@+id/editPhotoContainer"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/pet_photo_border"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">
                    <!-- Existing photo -->
                    <ImageView
                        android:id="@+id/ivEditPhoto"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/pet_photo_desc"
                        android:clipToOutline="true"
                        android:background="@drawable/circle_transparent" />
                    <!-- Camera overlay icon -->
                    <ImageView
                        android:id="@+id/ivCameraOverlay"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/camera_overlay_bg"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_camera"
                        android:tint="@color/neutral_000"
                        android:contentDescription="@string/pet_change_photo" />
                </FrameLayout>

                <!-- Nombre (ya existente) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPetName"
                    style="@style/RoundedOutlinedField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/pet_label_name"
                    app:boxBackgroundMode="outline"
                    app:hintTextColor="@color/maroon_900">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPetName"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/field_input_height"
                        android:inputType="textPersonName"
                        android:autofillHints="name"
                        android:imeOptions="actionNext"
                        android:singleLine="true"
                        android:textCursorDrawable="@drawable/cursor_maroon"
                        android:fontFamily="@font/nunito_light"
                        android:textColor="@color/maroon_900"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Raza -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPetBreed"
                    style="@style/RoundedOutlinedField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/pet_label_breed"
                    app:boxBackgroundMode="outline"
                    app:hintTextColor="@color/maroon_900">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPetBreed"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/field_input_height"
                        android:inputType="text"
                        android:autofillHints="text"
                        android:imeOptions="actionNext"
                        android:singleLine="true"
                        android:textCursorDrawable="@drawable/cursor_maroon"
                        android:fontFamily="@font/nunito_light"
                        android:textColor="@color/maroon_900"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Peso -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPetWeight"
                    style="@style/RoundedOutlinedField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/pet_label_weight"
                    app:boxBackgroundMode="outline"
                    app:hintTextColor="@color/maroon_900">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPetWeight"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/field_input_height"
                        android:hint="@string/pet_hint_weight"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionNext"
                        android:singleLine="true"
                        android:textCursorDrawable="@drawable/cursor_maroon"
                        android:fontFamily="@font/nunito_light"
                        android:textColor="@color/maroon_900"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Sexo (dropdown) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPetSex"
                    style="@style/RoundedOutlinedField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/pet_label_sex_short"
                    app:boxBackgroundMode="outline"
                    app:endIconMode="dropdown_menu"
                    app:endIconTint="@color/maroon_900"
                    app:hintTextColor="@color/maroon_900">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actvSex"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/field_input_height"
                        android:inputType="none"
                        android:imeOptions="actionNext"
                        android:singleLine="true"
                        android:cursorVisible="false"
                        android:dropDownHorizontalOffset="0dp"
                        android:dropDownVerticalOffset="0dp"
                        android:dropDownSelector="@android:color/transparent"
                        android:fontFamily="@font/nunito_light"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="start|center_vertical"
                        android:textColor="@color/maroon_900"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Fecha de nacimiento (campo clickable) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPetBirth"
                    style="@style/RoundedOutlinedField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/pet_label_birth_date"
                    app:boxBackgroundMode="outline"
                    app:hintTextColor="@color/maroon_900">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBirthDate"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/field_input_height"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textCursorDrawable="@drawable/cursor_maroon"
                        android:text="@string/pet_label_not_defined"
                        android:fontFamily="@font/nunito_light"
                        android:textColor="@color/maroon_900"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Castrado (dropdown Sí/No) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPetNeutered"
                    style="@style/RoundedOutlinedField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/pet_label_neutered_checkbox"
                    app:boxBackgroundMode="outline"
                    app:endIconMode="dropdown_menu"
                    app:endIconTint="@color/maroon_900"
                    app:hintTextColor="@color/maroon_900">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actvNeutered"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/field_input_height"
                        android:inputType="none"
                        android:imeOptions="actionNext"
                        android:singleLine="true"
                        android:cursorVisible="false"
                        android:dropDownSelector="@android:color/transparent"
                        android:fontFamily="@font/nunito_light"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:gravity="start|center_vertical"
                        android:textColor="@color/maroon_900"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Alto -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPetHeight"
                    style="@style/RoundedOutlinedField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/pet_label_height_cm"
                    app:boxBackgroundMode="outline"
                    app:hintTextColor="@color/maroon_900">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHeightCm"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/field_input_height"
                        android:hint="@string/pet_hint_height"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionNext"
                        android:singleLine="true"
                        android:textCursorDrawable="@drawable/cursor_maroon"
                        android:fontFamily="@font/nunito_light"
                        android:textColor="@color/maroon_900"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Largo -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPetLength"
                    style="@style/RoundedOutlinedField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/pet_label_length_cm"
                    app:boxBackgroundMode="outline"
                    app:hintTextColor="@color/maroon_900">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLengthCm"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/field_input_height"
                        android:hint="@string/pet_hint_length"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionDone"
                        android:singleLine="true"
                        android:textCursorDrawable="@drawable/cursor_maroon"
                        android:fontFamily="@font/nunito_light"
                        android:textColor="@color/maroon_900"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSavePet"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/pet_btn_save"
                        style="@style/NunitoBoldButtonRounded"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="4dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelEdit"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/pet_btn_cancel"
                        style="@style/NunitoBoldButtonRounded.Destructive"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="8dp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeletePetEdit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/pet_btn_delete"
                    style="@style/NunitoBoldButtonRounded.Destructive"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />
                <View
                    android:id="@+id/editModeBottomSpacer"
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Logo fijo, centrado horizontalmente y más grande -->
    <ImageView
        android:id="@+id/ivLogoLoveitoDog"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/logo_loveito_dog"
        android:scaleType="centerInside"
        android:contentDescription="@string/logo_loveito_dog_desc"
        android:importantForAccessibility="yes"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="56dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
