<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Foto visible en ambos modos -->
        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:maxHeight="300dp"
            android:src="@android:color/darker_gray"
            android:contentDescription="@string/pet_photo_desc" />

        <!-- VIEW MODE -->
        <LinearLayout
            android:id="@+id/groupView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Resumen con etiquetas -->
            <LinearLayout
                android:id="@+id/cardSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@color/bg_surface"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvSName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_label_name"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:id="@+id/tvSBreed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_label_breed"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:id="@+id/tvSWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_label_weight"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:id="@+id/tvSSex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_label_sex"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:id="@+id/tvSBirth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_label_birth"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:id="@+id/tvSAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_label_age"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:id="@+id/tvSNeutered"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_label_neutered"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:id="@+id/tvSHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_label_height"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:id="@+id/tvSLength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_label_length"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pet_label_crisis"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <!-- Lista de crisis -->
            <LinearLayout
                android:id="@+id/containerCrises"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartEdit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/pet_btn_edit"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/accent_primary"
                android:textColor="@color/accent_on"
                app:cornerRadius="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_gravity="center_horizontal" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeletePet"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/pet_btn_delete"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/error_default"
                android:textColor="@color/accent_on"
                app:cornerRadius="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_gravity="center_horizontal" />
        </LinearLayout>

        <!-- EDIT MODE -->
        <LinearLayout
            android:id="@+id/groupEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pet_label_profile_photo"
                android:textStyle="bold"
                android:layout_marginTop="12dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickImage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/pet_btn_pick_image"
                android:backgroundTint="@color/accent_primary"
                android:textColor="@color/accent_on"
                app:cornerRadius="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pet_label_name"
                android:layout_marginTop="12dp"/>
            <EditText
                android:id="@+id/etPetName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pet_hint_name"
                android:inputType="textPersonName"
                android:autofillHints="name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pet_label_breed"
                android:layout_marginTop="8dp"/>
            <EditText
                android:id="@+id/etPetBreed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pet_hint_breed"
                android:inputType="text"
                android:autofillHints="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pet_label_weight"
                android:layout_marginTop="8dp"/>
            <EditText
                android:id="@+id/etPetWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pet_hint_weight"
                android:inputType="numberDecimal"
                android:autofillHints="weight" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pet_label_sex_short"
                android:layout_marginTop="8dp"/>
            <Spinner
                android:id="@+id/spSex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pet_label_birth_date"
                android:layout_marginTop="8dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickBirth"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/pet_btn_pick_birth"
                    android:backgroundTint="@color/accent_primary"
                    android:textColor="@color/accent_on"
                    app:cornerRadius="12dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:id="@+id/tvBirthDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_label_not_defined"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbNeutered"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pet_label_neutered_checkbox"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pet_label_height_cm"
                android:layout_marginTop="8dp"/>
            <EditText
                android:id="@+id/etHeightCm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pet_hint_height"
                android:inputType="numberDecimal"
                android:autofillHints="height" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pet_label_length_cm"
                android:layout_marginTop="8dp"/>
            <EditText
                android:id="@+id/etLengthCm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pet_hint_length"
                android:inputType="numberDecimal"
                android:autofillHints="length" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSavePet"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/pet_btn_save"
                    android:backgroundTint="@color/accent_primary"
                    android:textColor="@color/accent_on"
                    app:cornerRadius="12dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="8dp"
                    android:layout_gravity="center_horizontal" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelEdit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/pet_btn_cancel"
                    android:backgroundTint="@color/accent_primary"
                    android:textColor="@color/accent_on"
                    app:cornerRadius="12dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="24dp"
                    android:layout_gravity="center_horizontal" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeletePetEdit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/pet_btn_delete_pet"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/error_default"
                android:textColor="@color/accent_on"
                app:cornerRadius="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_gravity="center_horizontal" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
