<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Loveito" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bg_primary</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_primary</item>
        <item name="colorOnSecondary">@color/accent_on</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error_default</item>
        <item name="colorOnError">@color/text_primary</item>
    </style>

    <!-- Overlay para color de cursor estándar maroon -->
    <style name="ThemeOverlay.Loveito.CursorMaroon" parent="ThemeOverlay.Material3">
        <item name="colorControlActivated">@color/maroon_900</item>
        <!-- materialCursorColor no existe en esta versión; usamos drawable personalizado -->
        <item name="android:textCursorDrawable">@drawable/cursor_maroon</item>
        <item name="colorPrimary">@color/maroon_900</item>
    </style>
</resources>
