<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NoUnderlineEditText">
        <item name="android:background">@drawable/edittext_accent_primary</item>
        <item name="android:textColor">@color/accent_primary</item>
        <item name="android:textColorHint">@color/accent_primary</item>
    </style>
    <style name="NunitoBoldButton" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">@color/accent_primary</item>
    </style>
    <style name="NunitoBoldButtonRounded" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">@color/accent_primary</item>
        <item name="android:textColor">@color/accent_on</item>
        <item name="cornerRadius">32dp</item>
    </style>
    <style name="NunitoBoldEditText" parent="android:Widget.EditText">
        <item name="android:textStyle">bold</item>
        <item name="android:textColorHint">@color/accent_primary</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="NunitoLightEditText" parent="android:Widget.EditText">
        <item name="android:fontFamily">@font/nunito_light</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColorHint">@color/accent_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">@drawable/edittext_accent_primary</item>
    </style>
    <style name="CustomPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:background">@color/accent_primary</item>
        <item name="android:textColor">@color/accent_on</item>
        <item name="android:fontFamily">@font/nunito_light</item>
    </style>

    <!-- NUEVOS ESTILOS REUTILIZABLES PARA MODO EDICIÓN -->
    <style name="EditSectionLabel" parent="android:TextAppearance">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/nunito_light</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/maroon_900</item>
    </style>
    <style name="EditCenterField" parent="android:Widget.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/nunito_light</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/maroon_900</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:backgroundTint">@color/maroon_900</item>
        <item name="android:textColorHint">@color/maroon_900</item>
    </style>

    <!-- Nuevo estilo para botones destructivos -->
    <style name="NunitoBoldButtonRounded.Destructive" parent="NunitoBoldButtonRounded">
        <item name="android:backgroundTint">@color/red_900</item>
        <item name="android:textColor">@color/accent_on</item>
    </style>
    <style name="EditSectionCheck" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:fontFamily">@font/nunito_light</item>
        <item name="android:textColor">@color/maroon_900</item>
        <item name="android:textSize">16sp</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/checkbox_custom_selector</item>
        <item name="android:padding">0dp</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>
    <style name="RoundedOutlinedFieldHint" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/nunito_light</item>
        <item name="android:textColor">@color/maroon_900</item>
    </style>
    <style name="RoundedOutlinedField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/maroon_900_stroke</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextAppearance">@style/RoundedOutlinedFieldHint</item>
        <item name="android:fontFamily">@font/nunito_light</item>
        <item name="hintTextColor">@color/maroon_900</item>
        <item name="android:textColorHint">@color/maroon_900</item>
    </style>
    <style name="ShapeAppearanceOverlay.LoveitoCircle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <color name="fab_ripple_tint">#1AF6E2CC</color>
    <!-- Ajuste: usar backgroundTint y ripple propio en lugar de android:background -->
    <style name="LoveitoCircularFab" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.LoveitoCircle</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
        <item name="pressedTranslationZ">0dp</item>
        <item name="hoveredFocusedTranslationZ">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="useCompatPadding">false</item>
        <item name="android:padding">0dp</item>
        <item name="backgroundTint">#230000</item>
        <item name="tint">#F6E2CC</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="borderWidth">0dp</item>
    </style>
    <style name="ThemeOverlay.Loveito.TimePicker" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">@color/maroon_900</item>
        <item name="colorOnPrimary">@color/accent_on</item>
        <item name="colorSecondary">@color/maroon_900</item>
        <item name="colorOnSecondary">@color/accent_on</item>
        <item name="android:textColorPrimary">@color/maroon_900</item>
        <item name="android:colorAccent">@color/maroon_900</item>
    </style>
    <style name="ThemeOverlay.Loveito.DatePicker" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/maroon_900</item>
        <item name="colorOnPrimary">@color/accent_on</item>
        <item name="colorSurface">@color/bg_primary</item>
        <item name="colorOnSurface">@color/maroon_900</item>
        <item name="android:textColorPrimary">@color/maroon_900</item>
        <item name="android:textColorSecondary">@color/maroon_900</item>
    </style>
</resources>
