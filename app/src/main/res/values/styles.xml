<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NoUnderlineEditText">
        <item name="android:background">@drawable/edittext_accent_primary</item>
        <item name="android:textColor">@color/accent_primary</item>
        <item name="android:textColorHint">@color/accent_primary</item>
    </style>
    <style name="NunitoBoldButton" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">@color/accent_primary</item>
    </style>
    <style name="NunitoBoldButtonRounded" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">@color/accent_primary</item>
        <item name="cornerRadius">32dp</item>
    </style>
    <style name="NunitoBoldEditText" parent="android:Widget.EditText">
        <item name="android:textStyle">bold</item>
        <item name="android:textColorHint">@color/accent_primary</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="NunitoLightEditText" parent="android:Widget.EditText">
        <item name="android:fontFamily">@font/nunito_light</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColorHint">@color/accent_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">@drawable/edittext_accent_primary</item>
    </style>
    <style name="CustomPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:background">@color/accent_primary</item>
        <item name="android:textColor">@color/accent_on</item>
        <item name="android:fontFamily">@font/nunito_light</item>
    </style>
</resources>
