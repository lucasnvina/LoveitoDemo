<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_configure_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/nunito_semibold"
            android:textColor="@color/maroon_900"
            android:layout_marginBottom="12dp" />

        <!-- Campo Severidad -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSeverity"
            style="@style/RoundedOutlinedField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/filter_severity"
            android:layout_marginTop="0dp"
            app:boxBackgroundMode="outline"
            app:endIconMode="dropdown_menu"
            app:endIconTint="@color/maroon_900"
            app:hintTextColor="@color/maroon_900">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actvSeverity"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_input_height"
                android:inputType="none"
                android:imeOptions="actionNext"
                android:singleLine="true"
                android:cursorVisible="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:fontFamily="@font/nunito_light"
                android:textColor="@color/maroon_900"
                android:textSize="20sp"
                android:textColorHint="@color/text_secondary"
                android:gravity="start|center_vertical" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Rango de Fechas (reemplaza título + botón) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDateRange"
            style="@style/RoundedOutlinedField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/filter_date_range"
            app:boxBackgroundMode="outline"
            app:hintTextColor="@color/maroon_900">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDateRange"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_input_height"
                android:focusable="false"
                android:clickable="true"
                android:inputType="text"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:fontFamily="@font/nunito_light"
                android:textColor="@color/maroon_900"
                android:textSize="20sp"
                android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Duraciones (sin título extra) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMinDuration"
                style="@style/RoundedOutlinedField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/filter_duration_min"
                app:boxBackgroundMode="outline"
                app:endIconMode="dropdown_menu"
                app:endIconTint="@color/maroon_900">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actvMinDuration"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/field_input_height"
                    android:inputType="none"
                    android:singleLine="true"
                    android:cursorVisible="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:fontFamily="@font/nunito_light"
                    android:textColor="@color/maroon_900"
                    android:textSize="20sp"
                    android:textColorHint="@color/text_secondary" />
            </com.google.android.material.textfield.TextInputLayout>
            <View
                android:layout_width="12dp"
                android:layout_height="0dp" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMaxDuration"
                style="@style/RoundedOutlinedField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/filter_duration_max"
                app:boxBackgroundMode="outline"
                app:endIconMode="dropdown_menu"
                app:endIconTint="@color/maroon_900">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actvMaxDuration"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/field_input_height"
                    android:inputType="none"
                    android:singleLine="true"
                    android:cursorVisible="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:fontFamily="@font/nunito_light"
                    android:textColor="@color/maroon_900"
                    android:textSize="20sp"
                    android:textColorHint="@color/text_secondary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApply"
                style="@style/NunitoBoldButtonRounded"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/filter_apply"
                android:textAllCaps="false"
                android:textSize="16sp" />
            <View
                android:layout_width="12dp"
                android:layout_height="0dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear"
                style="@style/NunitoBoldButtonRounded.Destructive"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/filter_clear"
                android:textAllCaps="false"
                android:textSize="16sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/NunitoBoldButtonRounded"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
