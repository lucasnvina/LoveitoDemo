<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Título con estilo consistente y color forzado #230000 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/crisis_history_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="@font/nunito_semibold"
        android:textColor="@color/maroon_900"
        android:layout_marginBottom="4dp" />

    <!-- Resumen + botón para configurar filtros en otra pantalla -->
    <LinearLayout
        android:id="@+id/filtersHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <TextView
            android:id="@+id/tvFilterSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filter_summary_none"
            android:textSize="12sp"
            android:fontFamily="@font/nunito_light"
            android:textColor="@color/maroon_900" />
        <ImageView
            android:id="@+id/btnClearFilters"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:contentDescription="@string/filter_clear"
            android:src="@drawable/ic_clear_filters"
            android:visibility="gone"
            android:background="@android:color/transparent" />
        <ImageView
            android:id="@+id/btnOpenFilters"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:contentDescription="@string/filter_apply"
            android:src="@drawable/ic_filter"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <!-- Lista -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCrises"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/crisis_empty_list"
        android:gravity="center"
        android:visibility="gone"
        android:textSize="14sp"
        android:fontFamily="@font/nunito_light"
        android:textColor="@color/maroon_900" />

</LinearLayout>
