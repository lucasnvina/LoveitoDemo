<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp"
        android:theme="@style/ThemeOverlay.Loveito.CursorMaroon">

        <!-- Foto con borde redondeado -->
        <FrameLayout
            android:id="@+id/editPhotoContainer"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/pet_photo_border"
            android:clipToOutline="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/ivEditPhoto"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:contentDescription="@string/pet_photo_desc"
                android:clipToOutline="true"
                android:background="@drawable/circle_transparent" />
            <ImageView
                android:id="@+id/ivCameraOverlay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/camera_overlay_bg"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_camera"
                android:tint="@color/neutral_000"
                android:contentDescription="@string/pet_change_photo" />
        </FrameLayout>

        <!-- Campo Nombre -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPetName"
            style="@style/RoundedOutlinedField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/pet_label_name"
            app:boxBackgroundMode="outline"
            app:hintTextColor="@color/maroon_900">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPetName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_input_height"
                android:inputType="textPersonName"
                android:imeOptions="actionNext"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:fontFamily="@font/nunito_light"
                android:textColor="@color/maroon_900"
                android:textSize="20sp"
                android:textCursorDrawable="@drawable/cursor_maroon"
                android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Raza -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPetBreed"
            style="@style/RoundedOutlinedField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pet_label_breed"
            app:boxBackgroundMode="outline"
            app:hintTextColor="@color/maroon_900">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPetBreed"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_input_height"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:fontFamily="@font/nunito_light"
                android:textColor="@color/maroon_900"
                android:textSize="20sp"
                android:textCursorDrawable="@drawable/cursor_maroon"
                android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Peso -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPetWeight"
            style="@style/RoundedOutlinedField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pet_label_weight"
            app:boxBackgroundMode="outline"
            app:hintTextColor="@color/maroon_900">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPetWeight"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_input_height"
                android:inputType="numberDecimal"
                android:imeOptions="actionNext"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:fontFamily="@font/nunito_light"
                android:textColor="@color/maroon_900"
                android:textSize="20sp"
                android:textCursorDrawable="@drawable/cursor_maroon"
                android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Sexo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPetSex"
            style="@style/RoundedOutlinedField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pet_label_sex_short"
            app:boxBackgroundMode="outline"
            app:endIconMode="dropdown_menu"
            app:endIconTint="@color/maroon_900"
            app:hintTextColor="@color/maroon_900">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actvSex"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_input_height"
                android:inputType="none"
                android:imeOptions="actionNext"
                android:singleLine="true"
                android:cursorVisible="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:fontFamily="@font/nunito_light"
                android:textColor="@color/maroon_900"
                android:textSize="20sp"
                android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fecha nacimiento -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPetBirth"
            style="@style/RoundedOutlinedField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pet_label_birth_date"
            app:boxBackgroundMode="outline"
            app:hintTextColor="@color/maroon_900">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBirthDate"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_input_height"
                android:focusable="false"
                android:clickable="true"
                android:inputType="text"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:fontFamily="@font/nunito_light"
                android:textColor="@color/maroon_900"
                android:textSize="20sp"
                android:textCursorDrawable="@drawable/cursor_maroon"
                android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Castrado -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPetNeutered"
            style="@style/RoundedOutlinedField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pet_label_neutered_checkbox"
            app:boxBackgroundMode="outline"
            app:endIconMode="dropdown_menu"
            app:endIconTint="@color/maroon_900"
            app:hintTextColor="@color/maroon_900">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actvNeutered"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_input_height"
                android:inputType="none"
                android:imeOptions="actionNext"
                android:singleLine="true"
                android:cursorVisible="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:fontFamily="@font/nunito_light"
                android:textColor="@color/maroon_900"
                android:textSize="20sp"
                android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Alto -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPetHeight"
            style="@style/RoundedOutlinedField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pet_label_height_cm"
            app:boxBackgroundMode="outline"
            app:hintTextColor="@color/maroon_900">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHeightCm"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_input_height"
                android:inputType="numberDecimal"
                android:imeOptions="actionNext"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:fontFamily="@font/nunito_light"
                android:textColor="@color/maroon_900"
                android:textSize="20sp"
                android:textCursorDrawable="@drawable/cursor_maroon"
                android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Largo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPetLength"
            style="@style/RoundedOutlinedField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pet_label_length_cm"
            app:boxBackgroundMode="outline"
            app:hintTextColor="@color/maroon_900">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLengthCm"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_input_height"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:fontFamily="@font/nunito_light"
                android:textColor="@color/maroon_900"
                android:textSize="20sp"
                android:textCursorDrawable="@drawable/cursor_maroon"
                android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/pet_btn_save"
                style="@style/NunitoBoldButtonRounded"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/pet_btn_cancel"
                style="@style/NunitoBoldButtonRounded.Destructive"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/pet_btn_delete"
            style="@style/NunitoBoldButtonRounded.Destructive"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="40dp" />
    </LinearLayout>
</ScrollView>
