<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <FrameLayout
            android:id="@+id/profilePhotoContainer"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/profile_photo_border"
            android:layout_marginBottom="16dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivProfilePhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_user_placeholder"
                android:scaleType="centerCrop"
                android:contentDescription="@string/user_photo_desc"
                android:padding="4dp" />

            <ImageView
                android:id="@+id/ivProfileCameraOverlay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/camera_overlay_bg"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_camera"
                android:tint="@color/neutral_000"
                android:contentDescription="@string/profile_change_photo"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre Apellido"
            android:textAlignment="center"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="normal"
            android:fontFamily="@font/nunito_light"
            android:textColor="#230000"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etFirstName"
            style="@style/EditCenterField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre"
            android:inputType="textPersonName"
            android:imeOptions="actionNext"
            android:autofillHints="name"
            android:visibility="gone"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/etLastName"
            style="@style/EditCenterField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Apellido"
            android:inputType="textPersonName"
            android:imeOptions="actionDone"
            android:autofillHints="name"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="email@ejemplo.com"
            android:textColor="#230000"
            android:textAlignment="center"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:textSize="16sp"
            android:textStyle="normal"
            android:fontFamily="@font/nunito_light" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modificar"
            style="@style/NunitoBoldButtonRounded"
            android:layout_marginTop="0dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="@color/accent_primary"
            android:textColor="@color/accent_on"
            app:cornerRadius="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar"
            style="@style/NunitoBoldButtonRounded"
            android:layout_marginTop="2dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="@color/accent_primary"
            android:textColor="@color/accent_on"
            app:cornerRadius="32dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            style="@style/NunitoBoldButtonRounded.Destructive"
            android:layout_marginTop="2dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
